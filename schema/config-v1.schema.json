{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:clavimo:schema:config:v1",
  "title": "Clavimo configuration (draft v1)",
  "description": "Provisional v1 format for engineering handoff, including optional draft deviceSettings. Replace example.invalid and finalize after macOS feasibility verification. This schema does not guarantee runtime support for any hardware-specific feature.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "configId",
    "engine",
    "activeProfileId",
    "profiles",
    "rules",
    "macros"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "configId": {
      "$ref": "#/$defs/uuid"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabledOnLaunch",
        "failOpen"
      ],
      "properties": {
        "enabledOnLaunch": {
          "type": "boolean"
        },
        "failOpen": {
          "const": true
        }
      }
    },
    "activeProfileId": {
      "type": "string",
      "minLength": 1
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "inherits"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "inherits": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "macros": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/macro"
      }
    },
    "deviceSettings": {
      "type": "array",
      "maxItems": 256,
      "default": [],
      "items": {
        "$ref": "#/$defs/deviceSetting"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codeNamespace",
        "code"
      ],
      "properties": {
        "codeNamespace": {
          "enum": [
            "macVirtualKeyCode",
            "hidUsage"
          ]
        },
        "code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "mods": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "command",
          "option",
          "control",
          "shift",
          "leftCommand",
          "rightCommand",
          "leftOption",
          "rightOption",
          "leftControl",
          "rightControl",
          "leftShift",
          "rightShift",
          "function"
        ]
      }
    },
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "key"
          ],
          "properties": {
            "kind": {
              "const": "key"
            },
            "key": {
              "$ref": "#/$defs/key"
            },
            "phase": {
              "enum": [
                "down",
                "up"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "first",
            "second"
          ],
          "properties": {
            "kind": {
              "const": "keyPair"
            },
            "first": {
              "$ref": "#/$defs/key"
            },
            "second": {
              "$ref": "#/$defs/key"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "requiredModifiers"
          ],
          "properties": {
            "kind": {
              "const": "modifierChord"
            },
            "requiredModifiers": {
              "$ref": "#/$defs/mods"
            },
            "key": {
              "$ref": "#/$defs/key"
            },
            "mouseButton": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "leaderKey",
            "mouseButton",
            "order"
          ],
          "properties": {
            "kind": {
              "const": "keyMouseChord"
            },
            "leaderKey": {
              "$ref": "#/$defs/key"
            },
            "mouseButton": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "order": {
              "enum": [
                "leaderThenMouse",
                "eitherOrder"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "mouseButton",
            "phase"
          ],
          "properties": {
            "kind": {
              "const": "mouseButton"
            },
            "mouseButton": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "phase": {
              "enum": [
                "down",
                "up"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "direction",
            "requiredModifiers"
          ],
          "properties": {
            "kind": {
              "const": "wheel"
            },
            "direction": {
              "enum": [
                "up",
                "down",
                "left",
                "right"
              ]
            },
            "requiredModifiers": {
              "$ref": "#/$defs/mods"
            },
            "minDelta": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "cooldownMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "key",
            "thresholdMs"
          ],
          "properties": {
            "kind": {
              "const": "tapHold"
            },
            "key": {
              "$ref": "#/$defs/key"
            },
            "thresholdMs": {
              "type": "integer",
              "minimum": 50,
              "maximum": 2000
            },
            "interruptPolicy": {
              "enum": [
                "none",
                "anyOtherKey",
                "permissiveHold"
              ]
            }
          }
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "key"
          ],
          "properties": {
            "kind": {
              "const": "sendKey"
            },
            "key": {
              "$ref": "#/$defs/key"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "key",
            "modifiers"
          ],
          "properties": {
            "kind": {
              "const": "sendShortcut"
            },
            "key": {
              "$ref": "#/$defs/key"
            },
            "modifiers": {
              "$ref": "#/$defs/mods"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "sideMode"
          ],
          "properties": {
            "kind": {
              "const": "swapKeys"
            },
            "sideMode": {
              "enum": [
                "left",
                "right",
                "both",
                "asSpecified"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "nextWorkspace",
                "previousWorkspace",
                "missionControl",
                "applicationWindows",
                "showDesktop",
                "none",
                "disableInput"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "bundleId"
          ],
          "properties": {
            "kind": {
              "const": "launchApp"
            },
            "bundleId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "profileId"
          ],
          "properties": {
            "kind": {
              "const": "activateProfile"
            },
            "profileId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "layerId"
          ],
          "properties": {
            "kind": {
              "enum": [
                "toggleLayer",
                "holdLayer"
              ]
            },
            "layerId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "macroId"
          ],
          "properties": {
            "kind": {
              "const": "runMacro"
            },
            "macroId": {
              "$ref": "#/$defs/uuid"
            }
          }
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "bundleId"
          ],
          "properties": {
            "kind": {
              "enum": [
                "appIs",
                "appIsNot"
              ]
            },
            "bundleId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "deviceId"
          ],
          "properties": {
            "kind": {
              "const": "physicalDeviceIs"
            },
            "deviceId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumeTrigger",
        "fireOn",
        "repeat"
      ],
      "properties": {
        "consumeTrigger": {
          "type": "boolean"
        },
        "fireOn": {
          "enum": [
            "down",
            "up",
            "hold"
          ]
        },
        "repeat": {
          "enum": [
            "once",
            "onAutorepeat",
            "rateLimited"
          ]
        },
        "leaderPolicy": {
          "enum": [
            "deferredUntilUp",
            "boundedWindow",
            "nonConsuming"
          ]
        },
        "leaderWindowMs": {
          "type": "integer",
          "minimum": 50,
          "maximum": 500
        },
        "repeatCooldownMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "allowProtectedButton": {
          "type": "boolean",
          "description": "Required to use the left or right mouse button in a modifier chord. Ordinary clicks are never affected."
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "enabled",
        "priority",
        "profileId",
        "trigger",
        "conditions",
        "action",
        "behavior",
        "ui"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "enabled": {
          "type": "boolean"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "profileId": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "$ref": "#/$defs/trigger"
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "behavior": {
          "$ref": "#/$defs/behavior"
        },
        "ui": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "order"
          ],
          "properties": {
            "order": {
              "type": "integer",
              "minimum": 0
            },
            "group": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    },
    "macro": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "steps"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/action"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "durationMs"
                ],
                "properties": {
                  "kind": {
                    "const": "wait"
                  },
                  "durationMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  }
                }
              }
            ]
          }
        }
      }
    },
    "deviceScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceClass"
      ],
      "properties": {
        "deviceClass": {
          "enum": [
            "mouse",
            "trackpad"
          ]
        },
        "vendorId": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{4}$"
        },
        "productId": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{4}$"
        },
        "appBundleId": {
          "type": "string",
          "minLength": 1
        },
        "displayId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "smoothing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "enum": [
            "linear",
            "easeIn",
            "easeOut",
            "easeInOut",
            "quadratic",
            "cubic",
            "quartic",
            "smooth",
            "custom"
          ]
        },
        "response": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 8
        },
        "acceleration": {
          "type": "number",
          "minimum": 0,
          "maximum": 8
        },
        "inertia": {
          "type": "number",
          "minimum": 0,
          "maximum": 8
        },
        "bouncing": {
          "type": "boolean"
        }
      }
    },
    "scrollAxis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reverse": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "system",
            "accelerated",
            "byLines",
            "byPixels",
            "smoothed"
          ]
        },
        "speedMultiplier": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "acceleration": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "distanceLines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "distancePixels": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 512
        },
        "smoothing": {
          "$ref": "#/$defs/smoothing"
        }
      }
    },
    "deviceSetting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "enabled",
        "profileId",
        "priority",
        "scope"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "enabled": {
          "type": "boolean"
        },
        "profileId": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "scope": {
          "$ref": "#/$defs/deviceScope"
        },
        "pointer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accelerationMode": {
              "enum": [
                "system",
                "disabled",
                "custom"
              ]
            },
            "acceleration": {
              "type": "number",
              "minimum": 0,
              "maximum": 20
            },
            "speedMultiplier": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10
            }
          }
        },
        "scrolling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vertical": {
              "$ref": "#/$defs/scrollAxis"
            },
            "horizontal": {
              "$ref": "#/$defs/scrollAxis"
            }
          }
        }
      }
    }
  }
}
