          "stringUnit": {
            "state": "translated",
            "value": "Trzymaj"
          }
        }
      }
    },
    "Hold A S D F or J K L ; for modifiers without leaving the home row; tap them to type as usual.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj A S D F albo J K L ; jako modyfikatory bez odrywania palców od środkowego rzędu; stuknij, żeby pisać jak zwykle."
          }
        }
      }
    },
    "Hold F + side button: next Space": {
      "localizations": {
