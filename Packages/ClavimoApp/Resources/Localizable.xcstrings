      }
    },
    "Hold Fn and click to switch Spaces, or open Mission Control with a side button.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte Fn und klicke, um Spaces zu wechseln, oder öffne Mission Control mit einer Seitentaste."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj Fn i kliknij, aby przełączyć biurko, albo otwórz Mission Control bocznym przyciskiem."
          }
        }
      }
    },
    "Hold Space for arrows": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leertaste halten für Pfeile"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj spację dla strzałek"
          }
        }
      }
    },
    "Hold Space: H J K L are arrows, U I jump by word, Y O go to the line start or end. Tap Space to type a space. Shift still selects.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leertaste halten: H J K L sind Pfeiltasten, U I springen wortweise, Y O gehen an Zeilenanfang oder -ende. Leertaste antippen für ein Leerzeichen. Die Umschalttaste wählt weiterhin aus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj spację: H J K L to strzałki, U I przeskakują o słowo, Y O idą na początek lub koniec wiersza. Stuknij spację, żeby wstawić spację. Shift dalej zaznacza."
          }
        }
      }
    },
