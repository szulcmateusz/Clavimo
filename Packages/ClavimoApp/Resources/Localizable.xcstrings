{
  "sourceLanguage": "en",
  "strings": {
    "%@  %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@  %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@  %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  %@"
          }
        }
      }
    },
    "%@ (%lld)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$lld)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (%2$lld)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%lld)"
          }
        }
      }
    },
    "%@ (active)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (aktiv)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (aktywny)"
          }
        }
      }
    },
    "%@ (none)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (keine)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (brak)"
          }
        }
      }
    },
    "%@ + %@: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ + %2$@: %3$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ + %2$@: %3$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ + %@: %@"
          }
        }
      }
    },
    "%@ acts as %@, and %@ acts as %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wirkt als %2$@ und %3$@ als %4$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ acts as %2$@, and %3$@ acts as %4$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ działa jak %@, a %@ jak %@."
          }
        }
      }
    },
    "%@ also types its character.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gibt außerdem sein Zeichen ein."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dodatkowo wpisuje swój znak."
          }
        }
      }
    },
    "%@ asked macOS to hide keystrokes (for example in a password field), so keyboard rules wait until it ends. Mouse and trackpad rules keep working.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat macOS gebeten, Tastatureingaben zu verbergen (zum Beispiel in einem Passwortfeld), daher warten Tastaturregeln, bis das endet. Maus- und Trackpad-Regeln funktionieren weiter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ poprosiła macOS o ukrycie naciśnięć klawiszy (na przykład w polu hasła), więc reguły klawiatury czekają, aż to się skończy. Reguły myszy i gładzika działają dalej."
          }
        }
      }
    },
    "%@ cannot be mapped to itself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann nicht auf sich selbst gelegt werden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie może być przypisany sam do siebie."
          }
        }
      }
    },
    "%@ cannot be typed by a rule. Rules can react to Caps Lock, but not send it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann von keiner Regel gesendet werden. Regeln können auf die Feststelltaste reagieren, sie aber nicht senden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reguła nie może wysłać klawisza %@. Reguły mogą reagować na Caps Lock, ale nie mogą go wysyłać."
          }
        }
      }
    },
    "%@ copy": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Kopie"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (kopia)"
          }
        }
      }
    },
    "%@ for the next key": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ für die nächste Taste"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dla następnego klawisza"
          }
        }
      }
    },
    "%@ has a key rule (a remap, tap or hold) and is also used in a key + mouse button rule. Keep only one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat eine Tastenregel (Neubelegung, Tippen oder Halten) und wird auch in einer Regel „Taste + Maustaste“ verwendet. Behalte nur eine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ma regułę klawisza (przemapowanie, stuknięcie lub przytrzymanie) i jest też użyty w regule klawisz + przycisk myszy. Zostaw tylko jedną."
          }
        }
      }
    },
    "%@ is a modifier. Use a modifier + mouse button rule instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist eine Sondertaste. Verwende stattdessen eine Regel „Sondertaste + Maustaste“."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ to modyfikator. Użyj reguły modyfikator + przycisk myszy."
          }
        }
      }
    },
    "%@ is already used by another rule with the same conditions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird bereits von einer anderen Regel mit denselben Bedingungen verwendet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jest już używany przez inną regułę z tymi samymi warunkami."
          }
        }
      }
    },
    "%@ is not a compass direction. Use up, upRight, right, downRight, down, downLeft, left or upLeft.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist keine Kompassrichtung. Verwende up, upRight, right, downRight, down, downLeft, left oder upLeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ to nie jest kierunek kompasu. Użyj up, upRight, right, downRight, down, downLeft, left albo upLeft."
          }
        }
      }
    },
    "%@ is running": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ läuft"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa %@"
          }
        }
      }
    },
    "%@ is running and may conflict": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ läuft und kann Konflikte verursachen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa %@ i może powodować konflikty"
          }
        }
      }
    },
    "%@ needs a layer name.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ braucht einen Ebenennamen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: podaj nazwę warstwy."
          }
        }
      }
    },
    "%@ needs at least one modifier.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ braucht mindestens eine Sondertaste."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wymaga co najmniej jednego modyfikatora."
          }
        }
      }
    },
    "%@ next key": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nächste Taste"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ następny klawisz"
          }
        }
      }
    },
    "%@ on layer %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ auf Ebene %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ on layer %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ na warstwie %@"
          }
        }
      }
    },
    "%@ runs %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ führt %2$@ aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ runs %2$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uruchamia: %@."
          }
        }
      }
    },
    "%@ to %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zu %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ to %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ na %@"
          }
        }
      }
    },
    "%@ use the same shortcut with the %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verwenden denselben Kurzbefehl mit „%@“."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ używają tego samego skrótu z przyciskiem „%@”."
          }
        }
      }
    },
    "%@ use the same trackpad gesture in the same situation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verwenden dieselbe Trackpad-Geste in derselben Situation."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ używają tego samego gestu gładzika w tej samej sytuacji."
          }
        }
      }
    },
    "%@ uses the %@ without allowing it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verwendet „%@“, ohne es zu erlauben."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ używa przycisku „%@” bez zezwolenia."
          }
        }
      }
    },
    "%@ µs": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ µs"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ µs"
          }
        }
      }
    },
    "%@, inherits from %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, erbt von %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@, inherits from %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, dziedziczy z: %@"
          }
        }
      }
    },
    "%@: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@"
          }
        }
      }
    },
    "%@: %@ is a modifier and cannot be used here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ ist eine Sondertaste und kann hier nicht verwendet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@: %2$@ is a modifier and cannot be used here."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@ to modyfikator i nie może być tu użyty."
          }
        }
      }
    },
    "%@: a combo needs two or three different keys, and each set of keys can be used once.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Eine Kombination braucht zwei oder drei verschiedene Tasten, und jede Tastengruppe kann nur einmal verwendet werden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: kombinacja wymaga dwóch lub trzech różnych klawiszy, a każdy zestaw klawiszy może być użyty raz."
          }
        }
      }
    },
    "%@: a half of the trackpad can be chosen for gestures only, not for clicks.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Eine Trackpad-Hälfte kann nur für Gesten gewählt werden, nicht für Klicks."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: połowę gładzika można wybrać tylko dla gestów, nie dla kliknięć."
          }
        }
      }
    },
    "%@: a modifier key keeps working as itself when held; only its tap can be changed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Eine Sondertaste funktioniert beim Halten weiter wie gewohnt; nur ihr Tippen kann geändert werden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: przytrzymany modyfikator działa dalej jak on sam; zmienić można tylko jego stuknięcie."
          }
        }
      }
    },
    "%@: a sequence needs one to four keys, without Escape.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Eine Tastenfolge braucht eine bis vier Tasten, ohne Escape."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: sekwencja wymaga od jednego do czterech klawiszy, bez Escape."
          }
        }
      }
    },
    "%@: a timing value is outside the allowed range.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Ein Zeitwert liegt außerhalb des erlaubten Bereichs."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: jeden z czasów jest poza dozwolonym zakresem."
          }
        }
      }
    },
    "%@: a two-finger tap is the macOS secondary click. Add a modifier, such as Fn.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Tippen mit zwei Fingern ist der Sekundärklick von macOS. Füge eine Sondertaste hinzu, etwa Fn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: stuknięcie dwoma palcami to w macOS kliknięcie prawym przyciskiem. Dodaj modyfikator, np. Fn."
          }
        }
      }
    },
    "%@: holding the key must send a key, modifiers or a layer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Halten der Taste muss eine Taste, Sondertasten oder eine Ebene senden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: przytrzymanie klawisza musi wysyłać klawisz, modyfikatory albo warstwę."
          }
        }
      }
    },
    "%@: key + mouse button shortcuts cannot be limited to a device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Kurzbefehle aus Taste + Maustaste lassen sich nicht auf ein Gerät beschränken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: skrótów klawisz + przycisk myszy nie można ograniczyć do urządzenia."
          }
        }
      }
    },
    "%@: no key starts a sequence. Add a leader key.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Keine Taste startet eine Tastenfolge. Füge eine Leader-Taste hinzu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: żaden klawisz nie rozpoczyna sekwencji. Dodaj klawisz wiodący."
          }
        }
      }
    },
    "%@: one sequence is the start of the other, so the longer one could never run.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Eine Tastenfolge ist der Anfang der anderen, daher könnte die längere nie ausgeführt werden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: jedna sekwencja jest początkiem drugiej, więc dłuższa nigdy by się nie uruchomiła."
          }
        }
      }
    },
    "%@: the %@ can only be combined with modifiers.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: „%@“ lässt sich nur mit Sondertasten kombinieren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: przycisk „%@” można łączyć tylko z modyfikatorami."
          }
        }
      }
    },
    "%@: this gesture cannot use that number of fingers.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Diese Geste kann nicht mit dieser Anzahl Finger verwendet werden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: ten gest nie może używać takiej liczby palców."
          }
        }
      }
    },
    "%@×": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@×"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@×"
          }
        }
      }
    },
    "%lld": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        }
      }
    },
