{
  "sourceLanguage": "en",
  "strings": {
    "%@  %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@  %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  %@"
          }
        }
      }
    },
    "%@ (%lld)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (%2$lld)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%lld)"
          }
        }
      }
    },
    "%@ (active)": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (aktywny)"
          }
        }
      }
    },
    "%@ (none)": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (brak)"
          }
        }
      }
    },
    "%@ + %@: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ + %2$@: %3$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ + %@: %@"
          }
        }
      }
    },
    "%@ acts as %@, and %@ acts as %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ acts as %2$@, and %3$@ acts as %4$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ działa jak %@, a %@ jak %@."
          }
        }
      }
    },
    "%@ also types its character.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dodatkowo wpisuje swój znak."
          }
        }
      }
    },
    "%@ asked macOS to hide keystrokes (for example in a password field), so keyboard rules wait until it ends. Mouse and trackpad rules keep working.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ poprosiła macOS o ukrycie naciśnięć klawiszy (na przykład w polu hasła), więc reguły klawiatury czekają, aż to się skończy. Reguły myszy i gładzika działają dalej."
          }
        }
      }
    },
    "%@ cannot be mapped to itself.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie może być przypisany sam do siebie."
          }
        }
      }
    },
    "%@ cannot be typed by a rule. Rules can react to Caps Lock, but not send it.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reguła nie może wysłać klawisza %@. Reguły mogą reagować na Caps Lock, ale nie mogą go wysyłać."
          }
        }
      }
    },
    "%@ copy": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (kopia)"
          }
        }
      }
    },
    "%@ for the next key": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dla następnego klawisza"
          }
        }
      }
    },
    "%@ has a key rule (a remap, tap or hold) and is also used in a key + mouse button rule. Keep only one.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ma regułę klawisza (przemapowanie, stuknięcie lub przytrzymanie) i jest też użyty w regule klawisz + przycisk myszy. Zostaw tylko jedną."
          }
        }
      }
    },
    "%@ is a modifier. Use a modifier + mouse button rule instead.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ to modyfikator. Użyj reguły modyfikator + przycisk myszy."
          }
        }
      }
    },
    "%@ is already used by another rule with the same conditions.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jest już używany przez inną regułę z tymi samymi warunkami."
          }
        }
      }
    },
    "%@ is running": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa %@"
          }
        }
      }
    },
    "%@ is running and may conflict": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa %@ i może powodować konflikty"
          }
        }
      }
    },
    "%@ needs a layer name.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: podaj nazwę warstwy."
          }
        }
      }
    },
    "%@ needs at least one modifier.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wymaga co najmniej jednego modyfikatora."
          }
        }
      }
    },
    "%@ next key": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ następny klawisz"
          }
        }
      }
    },
    "%@ on layer %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ on layer %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ na warstwie %@"
          }
        }
      }
    },
    "%@ runs %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ runs %2$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uruchamia: %@."
          }
        }
      }
    },
    "%@ to %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ to %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ na %@"
          }
        }
      }
    },
    "%@ use the same shortcut with the %@.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ używają tego samego skrótu z przyciskiem „%@”."
          }
        }
      }
    },
    "%@ use the same trackpad gesture in the same situation.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ używają tego samego gestu gładzika w tej samej sytuacji."
          }
        }
      }
    },
    "%@ uses the %@ without allowing it.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ używa przycisku „%@” bez zezwolenia."
          }
        }
      }
    },
    "%@ µs": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ µs"
          }
        }
      }
    },
    "%@, inherits from %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@, inherits from %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, dziedziczy z: %@"
          }
        }
      }
    },
    "%@: %@": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@"
          }
        }
      }
    },
    "%@: %@ is a modifier and cannot be used here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@: %2$@ is a modifier and cannot be used here."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@ to modyfikator i nie może być tu użyty."
          }
        }
      }
    },
    "%@: a combo needs two or three different keys, and each set of keys can be used once.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: kombinacja wymaga dwóch lub trzech różnych klawiszy, a każdy zestaw klawiszy może być użyty raz."
          }
        }
      }
    },
    "%@: a half of the trackpad can be chosen for gestures only, not for clicks.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: połowę gładzika można wybrać tylko dla gestów, nie dla kliknięć."
          }
        }
      }
    },
    "%@: a modifier key keeps working as itself when held; only its tap can be changed.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: przytrzymany modyfikator działa dalej jak on sam; zmienić można tylko jego stuknięcie."
          }
        }
      }
    },
    "%@: a sequence needs one to four keys, without Escape.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: sekwencja wymaga od jednego do czterech klawiszy, bez Escape."
          }
        }
      }
    },
    "%@: a timing value is outside the allowed range.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: jeden z czasów jest poza dozwolonym zakresem."
          }
        }
      }
    },
    "%@: a two-finger tap is the macOS secondary click. Add a modifier, such as Fn.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: stuknięcie dwoma palcami to w macOS kliknięcie prawym przyciskiem. Dodaj modyfikator, np. Fn."
          }
        }
      }
    },
    "%@: holding the key must send a key, modifiers or a layer.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: przytrzymanie klawisza musi wysyłać klawisz, modyfikatory albo warstwę."
          }
        }
      }
    },
    "%@: key + mouse button shortcuts cannot be limited to a device.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: skrótów klawisz + przycisk myszy nie można ograniczyć do urządzenia."
          }
        }
      }
    },
    "%@: no key starts a sequence. Add a leader key.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: żaden klawisz nie rozpoczyna sekwencji. Dodaj klawisz wiodący."
          }
        }
      }
    },
    "%@: one sequence is the start of the other, so the longer one could never run.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: jedna sekwencja jest początkiem drugiej, więc dłuższa nigdy by się nie uruchomiła."
          }
        }
      }
    },
    "%@: the %@ can only be combined with modifiers.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: przycisk „%@” można łączyć tylko z modyfikatorami."
          }
        }
      }
    },
    "%@: this gesture cannot use that number of fingers.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: ten gest nie może używać takiej liczby palców."
          }
        }
      }
    },
    "%@×": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@×"
          }
        }
      }
    },
