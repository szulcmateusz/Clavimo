    "Hold Space for arrows": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj spację dla strzałek"
          }
        }
      }
    },
    "Hold Space: H J K L are arrows, U I jump by word, Y O go to the line start or end. Tap Space to type a space. Shift still selects.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj spację: H J K L to strzałki, U I przeskakują o słowo, Y O idą na początek lub koniec wiersza. Stuknij spację, żeby wstawić spację. Shift dalej zaznacza."
          }
        }
      }
    },
    "Hold Tab for numbers": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj Tab dla cyfr"
          }
        }
      }
    },
    "Hold Tab: U I O, J K L and M , . type 7 to 1 like a number pad, N types 0. Tap Tab as usual.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj Tab: U I O, J K L oraz M , . wpisują cyfry od 7 do 1 jak klawiatura numeryczna, N wpisuje 0. Tab stuknięty działa jak zwykle."
          }
