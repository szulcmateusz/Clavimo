        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte A S D F oder J K L ; für Sondertasten, ohne die Grundreihe zu verlassen; tippe sie an, um wie gewohnt zu schreiben."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj A S D F albo J K L ; jako modyfikatory bez odrywania palców od środkowego rzędu; stuknij, żeby pisać jak zwykle."
          }
        }
      }
    },
    "Hold F + side button: next Space": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "F halten + Seitentaste: nächster Space"
