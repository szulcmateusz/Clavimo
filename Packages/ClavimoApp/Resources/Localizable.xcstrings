            "state": "translated",
            "value": "Option"
          }
        }
      }
    },
    "Ordinary clicks are never affected: only clicks made while exactly these modifiers are held are replaced by the action.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Normale Klicks sind nie betroffen: Nur Klicks, bei denen genau diese Sondertasten gehalten werden, werden durch die Aktion ersetzt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwykłe kliknięcia działają jak dotąd: akcją zastępowane są tylko kliknięcia przy wciśniętych dokładnie tych modyfikatorach."
          }
        }
      }
    },
    "Other": {
      "localizations": {
