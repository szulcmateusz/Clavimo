    "Both directions are created: pressing either key produces the other, including in shortcuts. Left and right modifiers are separate keys.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa w obie strony: każdy z klawiszy daje drugi, także w skrótach. Lewe i prawe modyfikatory to osobne klawisze."
          }
        }
      }
    },
