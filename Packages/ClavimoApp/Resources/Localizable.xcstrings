      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ms"
          }
        }
      }
    },
    "%lld own rules": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld own rule"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld own rules"
                }
              }
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "własne reguły: %lld"
          }
        }
      }
    },
    "%lld px": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld px"
          }
        }
      }
    },
