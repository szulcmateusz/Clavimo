    "With": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z klawiszami"
          }
        }
      }
    },
    "With no modifiers selected, the gesture works only while no modifier is held. Choose a half or a corner of the trackpad to give the same gesture different jobs.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez zaznaczonych modyfikatorów gest działa tylko wtedy, gdy żaden modyfikator nie jest przytrzymany. Wybierz połowę albo róg gładzika, żeby ten sam gest robił w różnych miejscach co innego."
          }
        }
      }
    },
    "With several fingers": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilkoma palcami"
          }
        }
      }
    },
    "You can change or remove them at any time in Rules.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz je w każdej chwili zmienić lub usunąć w zakładce Reguły."
          }
        }
      }
    },
    "Your devices": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje urządzenia"
          }
        }
      }
    },
    "Your keyboard rules": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje reguły klawiatury"
          }
        }
      }
    },
    "Your rules are applied to keyboard and mouse input.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje reguły działają na klawiaturze i myszy."
          }
        }
      }
    },
    "Your trackpad rules": {
      "localizations": {
        "pl": {
