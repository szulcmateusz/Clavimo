          }
        }
      }
    },
    "Held back": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymane"
          }
        }
      }
    },
    "Held, the key stays %@. The tap output runs when you press and release it alone.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymany klawisz pozostaje klawiszem %@. Wynik stuknięcia działa, gdy naciśniesz i puścisz go samodzielnie."
          }
        }
      }
    },
    "Help": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Help"
          }
        }
      }
    },
    "Hold": {
      "localizations": {
