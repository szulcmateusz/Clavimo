    "Dimmed actions come from the page used everywhere. Click to change them in this app only, or hide them here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgeblendete Aktionen kommen von der Seite für überall. Klicke, um sie nur in dieser App zu ändern, oder blende sie hier aus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przygaszone akcje pochodzą ze strony używanej wszędzie. Kliknij, żeby zmienić je tylko w tej aplikacji, albo ukryj je tutaj."
          }
        }
      }
    },
