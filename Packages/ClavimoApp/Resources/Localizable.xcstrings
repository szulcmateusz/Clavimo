{
  "sourceLanguage": "en",
  "strings": {
    "%@  %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@  %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  %@"
          }
        }
      }
    },
    "%@ (%lld)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (%2$lld)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%lld)"
          }
        }
      }
    },
    "%@ (active)": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (aktywny)"
          }
        }
      }
    },
    "%@ (none)": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (brak)"
          }
        }
      }
    },
    "%@ + %@: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ + %2$@: %3$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ + %@: %@"
          }
        }
      }
    },
    "%@ acts as %@, and %@ acts as %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ acts as %2$@, and %3$@ acts as %4$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ działa jak %@, a %@ jak %@."
          }
        }
      }
    },
    "%@ also types its character.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dodatkowo wpisuje swój znak."
          }
        }
      }
    },
    "%@ cannot be mapped to itself.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie może być przypisany sam do siebie."
          }
        }
      }
    },
    "%@ cannot be remapped yet.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie da się jeszcze przemapować."
          }
        }
      }
    },
    "%@ copy": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (kopia)"
          }
        }
      }
    },
    "%@ is a modifier. Use a modifier + mouse button rule instead.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ to modyfikator. Użyj reguły modyfikator + przycisk myszy."
          }
        }
      }
    },
    "%@ is already used by another rule with the same conditions.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jest już używany przez inną regułę z tymi samymi warunkami."
          }
        }
      }
    },
    "%@ is both remapped and used in a mouse shortcut. Keep only one.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jest jednocześnie przemapowany i użyty w skrócie z myszą. Zostaw tylko jedno."
          }
        }
      }
    },
    "%@ is running": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa %@"
          }
        }
      }
    },
    "%@ is running and may conflict": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa %@ i może powodować konflikty"
          }
        }
      }
    },
    "%@ needs at least one modifier.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wymaga co najmniej jednego modyfikatora."
          }
        }
      }
    },
    "%@ to %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ to %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ na %@"
          }
        }
      }
    },
    "%@ use the same shortcut with the %@.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ używają tego samego skrótu z przyciskiem „%@”."
          }
        }
      }
    },
    "%@ uses the %@ without allowing it.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ używa przycisku „%@” bez zezwolenia."
          }
        }
      }
    },
    "%@ µs": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ µs"
          }
        }
      }
    },
    "%@, inherits from %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@, inherits from %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, dziedziczy z: %@"
          }
        }
      }
    },
    "%@: %@": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@"
          }
        }
      }
    },
    "%@: key + mouse button shortcuts cannot be limited to a device.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: skrótów klawisz + przycisk myszy nie można ograniczyć do urządzenia."
          }
        }
      }
    },
    "%@: the %@ can only be combined with modifiers.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: przycisk „%@” można łączyć tylko z modyfikatorami."
          }
        }
      }
    },
    "%@×": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@×"
          }
        }
      }
    },
