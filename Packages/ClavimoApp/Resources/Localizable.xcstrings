    "Trackpads scroll like this: %@. Mouse wheels keep their own setting.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gładziki przewijają tak: %@. Kółka myszy mają własne ustawienie."
          }
        }
      }
    },
    "Try it": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypróbuj"
          }
        }
      }
    },
    "Tune the mouse wheel": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostosuj kółko myszy"
          }
        }
      }
    },
    "Turn": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrót"
          }
        }
      }
    },
    "Turn a layer on or off": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz lub wyłącz warstwę"
          }
        }
      }
    },
    "Turn on Clavimo in both lists. This page updates by itself.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz Clavimo na obu listach. Ta strona odświeży się sama."
          }
        }
      }
    },
    "Turn on a layer while held": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz warstwę na czas przytrzymania"
          }
        }
      }
    },
    "Turn remapping on to collect measurements.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz działanie, aby zbierać pomiary."
          }
        }
      }
    },
    "Turn remapping on when Clavimo starts": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączaj działanie przy starcie Clavimo"
          }
        }
      }
    },
    "Turn two fingers clockwise": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrót dwoma palcami w prawo"
          }
        }
      }
    },
    "Turn two fingers clockwise: volume up": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrót dwoma palcami w prawo: głośniej"
          }
        }
      }
    },
    "Turn two fingers counterclockwise": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrót dwoma palcami w lewo"
          }
        }
      }
    },
    "Turn two fingers counterclockwise: volume down": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrót dwoma palcami w lewo: ciszej"
          }
        }
      }
    },
    "Turn two fingers like a knob: every 15 degrees run the action once more, so it works well for volume or brightness. To keep it from happening by accident, choose a corner of the trackpad or a key to hold, such as fn.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kręć dwoma palcami jak pokrętłem: co 15 stopni akcja wykonuje się jeszcze raz, więc świetnie nadaje się do głośności albo jasności. Żeby nie zadziałała przypadkiem, wybierz róg gładzika albo klawisz do przytrzymania, np. fn."
          }
        }
      }
    },
    "Two mouse wheel settings apply in the same situation. Keep one.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwa ustawienia kółka myszy działają w tej samej sytuacji. Zostaw jedno."
          }
        }
      }
    },
    "Two rules share the ID %@.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwie reguły mają ten sam identyfikator %@."
          }
        }
      }
    },
    "Two tools changing the keyboard or mouse at once can apply rules twice. Quit one of them.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwa narzędzia zmieniające klawiaturę lub mysz naraz mogą zastosować reguły podwójnie. Zakończ jedno z nich."
          }
        }
      }
    },
    "Two trackpad scrolling settings apply in the same situation. Keep one.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwa ustawienia przewijania gładzika dotyczą tej samej sytuacji. Zostaw jedno."
          }
        }
      }
    },
    "Type a key": {
