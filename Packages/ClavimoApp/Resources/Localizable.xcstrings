      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab"
          }
        }
      }
    },
    "The %@ condition has no value.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Warunek %@ nie ma wartości."
          }
        }
      }
    },
    "The action %@ is not supported yet.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Akcja %@ nie jest jeszcze obsługiwana."
          }
        }
      }
    },
    "The active profile %@ does not exist.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywny profil %@ nie istnieje."
          }
        }
      }
    },
    "The condition %@ is not supported.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Warunek %@ nie jest obsługiwany."
          }
        }
      }
    },
    "The configuration file cannot be read: %@": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać pliku konfiguracji: %@"
          }
        }
      }
    },
    "The configuration file could not be loaded.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wczytać pliku konfiguracji."
          }
        }
      }
    },
    "The configuration file is not valid: %@": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik konfiguracji jest nieprawidłowy: %@"
          }
        }
      }
    },
    "The configuration was made by a newer version of Clavimo (format %lld). Update Clavimo to use it.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguracja pochodzi z nowszej wersji Clavimo (format %lld). Zaktualizuj Clavimo, aby jej użyć."
          }
        }
      }
    },
    "The exact set of held modifiers must match.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wciśnięte modyfikatory muszą zgadzać się dokładnie."
          }
        }
      }
    },
    "The key is held back briefly. Clicking within the window triggers the action; otherwise the key types as usual, slightly delayed.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawisz jest na chwilę wstrzymywany. Kliknięcie w tym czasie uruchamia akcję; w przeciwnym razie klawisz wpisuje się normalnie, z lekkim opóźnieniem."
          }
        }
      }
    },
    "The key must be held before the mouse button is pressed.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawisz musi być wciśnięty przed naciśnięciem przycisku myszy."
          }
        }
      }
    },
    "The key never types by accident, but it types only when released and does not repeat while held.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawisz nigdy nie wpisze się przypadkiem, ale wpisuje się dopiero po puszczeniu i nie powtarza się przy przytrzymaniu."
          }
        }
      }
    },
    "The key types instantly and the action still triggers, but the character also reaches the app.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawisz wpisuje się od razu i akcja też działa, ale znak trafia do aplikacji."
          }
        }
      }
    },
    "The key uses a code format Clavimo does not read yet.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawisz ma zapis kodu, którego Clavimo jeszcze nie odczytuje."
          }
        }
      }
    },
    "The macOS acceleration curve, faster or slower.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krzywa przyspieszenia macOS, szybciej lub wolniej."
          }
        }
      }
    },
    "The mouse button number is not valid.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Numer przycisku myszy jest nieprawidłowy."
          }
        }
      }
    },
    "The mouse wheel setting changes nothing.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To ustawienie kółka myszy niczego nie zmienia."
          }
        }
      }
    },
    "The profile %@ inherits from itself through other profiles.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil %@ dziedziczy sam z siebie przez inne profile."
          }
        }
      }
    },
    "The report contains versions, settings and measurements, never what you typed.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raport zawiera wersje, ustawienia i pomiary, nigdy wpisywanego tekstu."
          }
        }
      }
    },
    "The rule is incomplete. Edit or delete it.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reguła jest niekompletna. Popraw ją albo usuń."
          }
        }
      }
    },
    "The same distance for every notch, without acceleration. Experimental.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta sama odległość dla każdego ząbka, bez przyspieszenia. Eksperymentalne."
          }
        }
      }
    },
    "The same number of lines for every notch, without acceleration.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta sama liczba linii dla każdego ząbka, bez przyspieszenia."
          }
        }
      }
    },
    "The scroll distance or speed is outside the allowed range.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odległość lub szybkość przewijania jest poza dozwolonym zakresem."
          }
        }
      }
    },
    "The scroll mode %@ is not supported yet.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb przewijania %@ nie jest jeszcze obsługiwany."
          }
        }
      }
    },
    "The scroll option %@ is not supported yet.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcja przewijania %@ nie jest jeszcze obsługiwana."
          }
        }
      }
    },
    "The scroll setting changes nothing.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To ustawienie przewijania niczego nie zmienia."
          }
        }
      }
    },
    "The waiting time for %@ (%lld ms) must be between 50 and 500 ms.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas oczekiwania dla %@ (%lld ms) musi mieścić się między 50 a 500 ms."
          }
        }
      }
    },
    "Then": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wtedy"
          }
        }
      }
    },
    "There is no previous version yet. One is kept every time you change a rule.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze poprzedniej wersji. Zachowuje się ją przy każdej zmianie reguły."
          }
        }
      }
    },
    "This profile also uses %lld rules inherited from %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This profile also uses %1$lld rules inherited from %2$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten profil używa też odziedziczonych reguł (%lld) z: %@."
          }
        }
      }
    },
    "Time Clavimo adds to each event, measured on this Mac. It does not include USB, Bluetooth or display latency.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas, jaki Clavimo dodaje do każdego zdarzenia, zmierzony na tym Macu. Nie obejmuje opóźnień USB, Bluetooth ani ekranu."
          }
        }
      }
    },
    "Trackpad settings are not changed by Clavimo.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clavimo nie zmienia ustawień gładzika."
          }
        }
      }
    },
    "Try it": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypróbuj"
          }
        }
      }
    },
    "Tune the mouse wheel": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostosuj kółko myszy"
          }
        }
      }
    },
    "Turn on Clavimo in both lists. This page updates by itself.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz Clavimo na obu listach. Ta strona odświeży się sama."
          }
        }
      }
    },
    "Turn remapping on to collect measurements.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz działanie, aby zbierać pomiary."
          }
        }
      }
    },
    "Turn remapping on when Clavimo starts": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączaj działanie przy starcie Clavimo"
          }
        }
      }
    },
    "Two mouse wheel settings apply in the same situation. Keep one.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwa ustawienia kółka myszy działają w tej samej sytuacji. Zostaw jedno."
          }
        }
      }
    },
    "Two rules share the ID %@.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwie reguły mają ten sam identyfikator %@."
          }
        }
      }
    },
    "Two tools changing the keyboard or mouse at once can apply rules twice. Quit one of them.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwa narzędzia zmieniające klawiaturę lub mysz naraz mogą zastosować reguły podwójnie. Zakończ jedno z nich."
          }
        }
      }
    },
    "Type immediately": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisuj od razu"
          }
        }
      }
    },
    "Unavailable (Input Monitoring needed)": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedostępne (wymaga Monitorowania wejścia)"
          }
        }
      }
    },
    "Unavailable for this copy of the app": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedostępne dla tej kopii aplikacji"
          }
        }
      }
    },
    "Unchanged": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez zmian"
          }
        }
      }
    },
    "Unknown": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieznany"
          }
        }
      }
    },
    "Unsupported Rules (%lld)": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieobsługiwane reguły (%lld)"
          }
        }
      }
    },
    "Until I Resume": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do czasu wznowienia"
          }
        }
      }
    },
    "Up Arrow": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strzałka w górę"
          }
        }
      }
    },
    "Use \"Modifier + mouse button\" for modifier keys.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla modyfikatorów użyj typu „Modyfikator + przycisk myszy”."
          }
        }
      }
    },
    "Uses the macOS Mission Control keyboard shortcuts (Control + Arrow keys). They must be enabled in System Settings > Keyboard > Keyboard Shortcuts > Mission Control.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używa skrótów Mission Control w macOS (Control + strzałki). Muszą być włączone w Ustawieniach systemowych > Klawiatura > Skróty klawiszowe > Mission Control."
          }
        }
      }
    },
    "Version %@": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersja %@"
          }
        }
      }
    },
    "Vertical": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pionowo"
          }
        }
      }
    },
    "Vertical: %@": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pionowo: %@"
          }
        }
      }
    },
    "Wait until the key is released": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czekaj do puszczenia klawisza"
          }
        }
      }
    },
    "Waiting for permissions": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czeka na uprawnienia"
          }
        }
      }
    },
    "Welcome to Clavimo": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Witaj w Clavimo"
          }
        }
      }
    },
    "Wheel": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kółko"
          }
        }
      }
    },
    "When": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiedy"
          }
        }
      }
    },
    "When I press": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy naciskam"
          }
        }
      }
    },
    "When you start Clavimo, it lives in the menu bar. Check that everything still feels normal:": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po uruchomieniu Clavimo działa w pasku menu. Sprawdź, czy wszystko działa normalnie:"
          }
        }
      }
    },
    "While waiting": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas czekania"
          }
        }
      }
    },
    "While you hold %@, the %@ runs %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "While you hold %1$@, the %2$@ runs %3$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy trzymasz %@, %@ uruchamia: %@."
          }
        }
      }
    },
    "While you hold %@, the %@ runs %@. Other clicks work as usual.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "While you hold %1$@, the %2$@ runs %3$@. Other clicks work as usual."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy trzymasz %@, %@ uruchamia: %@. Pozostałe kliknięcia działają normalnie."
          }
        }
      }
    },
    "Window: %lld ms": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas oczekiwania: %lld ms"
          }
        }
      }
    },
    "You can change or remove them at any time in Rules.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz je w każdej chwili zmienić lub usunąć w zakładce Reguły."
          }
        }
      }
    },
    "Your devices": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje urządzenia"
          }
        }
      }
    },
    "Your rules are applied to keyboard and mouse input.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje reguły działają na klawiaturze i myszy."
          }
        }
      }
    },
    "all enabled": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "wszystkie włączone"
          }
        }
      }
    },
    "left": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "lewy"
          }
        }
      }
    },
    "macOS asks you to approve this once, in System Settings. Each macOS account approves separately, and you can revoke it at any time.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS poprosi o jednorazową zgodę w Ustawieniach systemowych. Każde konto macOS zatwierdza ją osobno i w każdej chwili możesz ją cofnąć."
          }
        }
      }
    },
    "macOS does not say which device a key press came from. When a rule is limited to a device, Clavimo asks the connected devices which one is holding the key. If two devices report it, or none does, the rule does not apply. Two devices of the same model share an ID.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS nie podaje, z którego urządzenia pochodzi naciśnięcie. Gdy reguła jest ograniczona do urządzenia, Clavimo pyta podłączone urządzenia, które z nich trzyma klawisz. Jeśli zgłoszą to dwa albo żadne, reguła nie działa. Dwa urządzenia tego samego modelu mają ten sam identyfikator."
          }
        }
      }
    },
    "macOS sets pointer speed and acceleration for all mice. Turn acceleration off in Mouse > Advanced for movement that matches your hand exactly.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybkość i przyspieszenie wskaźnika macOS ustawia dla wszystkich myszy. Wyłącz przyspieszenie w Mysz > Zaawansowane, aby ruch kursora dokładnie odpowiadał ruchowi ręki."
          }
        }
      }
    },
    "macOS stopped the input connection several times. Resume after checking for conflicts.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS kilka razy przerwał połączenie z wejściem. Wznów po sprawdzeniu konfliktów."
          }
        }
      }
    },
    "pointer acceleration off": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "przyspieszenie wskaźnika wyłączone"
          }
        }
      }
    },
    "pointer acceleration on": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "przyspieszenie wskaźnika włączone"
          }
        }
      }
    },
    "reversed": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "odwrócone"
          }
        }
      }
    },
    "right": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "prawy"
          }
        }
      }
    },
    "smooth, %lld px per notch": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "płynnie, %lld px na ząbek"
          }
        }
      }
    },
    "space": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "spacja"
          }
        }
      }
    },
    "speed %@×": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "szybkość %@×"
          }
        }
      }
    },
    "µs": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "µs"
          }
        }
      }
    }
  },
  "version": "1.0"
}
