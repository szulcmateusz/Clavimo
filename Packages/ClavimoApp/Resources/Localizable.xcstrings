    "%lld rules that belong only to this profile will be deleted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Regeln, die nur zu diesem Profil gehören, werden gelöscht."
          }
        },
        "en": {
