    },
    "Fn + right click: next Space": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fn + Rechtsklick: nächster Space"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fn + prawy klik: następne biurko"
          }
