    "Paste the rules an AI assistant wrote, or any Clavimo rules in JSON. You see every change before it is applied.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Regeln ein, die ein KI-Assistent geschrieben hat, oder beliebige Clavimo-Regeln als JSON. Du siehst jede Änderung, bevor sie übernommen wird."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej reguły napisane przez asystenta AI albo dowolne reguły Clavimo w JSON. Zobaczysz każdą zmianę, zanim zostanie zastosowana."
          }
        }
      }
    },
