              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Finger"
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld finger"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld fingers"
                }
              }
            }
          }
        },
        "pl": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld palce"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld palców"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld palec"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld palca"
                }
              }
            }
          }
        }
      }
    },
    "%lld keyboards": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Tastatur"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Tastaturen"
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld keyboard"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld keyboards"
                }
              }
            }
          }
        },
        "pl": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld klawiatury"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld klawiatur"
                }
