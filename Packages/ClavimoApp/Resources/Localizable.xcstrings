          }
        }
      }
    },
    "After the leader key, type these keys one after another. A panel shows the keys that can come next; Esc cancels.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke nach der Leader-Taste diese Tasten nacheinander. Ein Panel zeigt die Tasten, die als Nächstes kommen können; Esc bricht ab."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po klawiszu wiodącym naciśnij te klawisze po kolei. Panel pokazuje, jakie klawisze mogą być następne; Esc anuluje."
          }
        }
      }
    },
    "All": {
      "localizations": {
        "de": {
