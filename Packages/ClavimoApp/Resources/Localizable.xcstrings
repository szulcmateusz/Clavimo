          "stringUnit": {
            "state": "translated",
            "value": "Öffnet %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera: %@"
          }
        }
      }
    },
    "Opens a link in a new tab, or closes a tab when you tap its title.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet einen Link in einem neuen Tab oder schließt einen Tab, wenn du auf seinen Titel tippst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera link w nowej karcie albo zamyka kartę, gdy stukniesz w jej tytuł."
          }
        }
      }
    },
    "Opens the compass at the pointer. Move towards an action and click, or press Esc.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet den Kompass am Zeiger. Beweg dich zu einer Aktion und klicke, oder drück Esc."
          }
