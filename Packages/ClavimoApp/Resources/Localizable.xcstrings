    "Clavimo": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clavimo"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clavimo"
          }
        }
      }
    },
    "Clavimo could not read this app's menus. Check that Clavimo has Accessibility permission and that the app is still open.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clavimo kann die Menüs dieser App nicht lesen. Prüfe, ob Clavimo die Berechtigung „Bedienungshilfen“ hat und die App noch geöffnet ist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clavimo nie może odczytać menu tej aplikacji. Sprawdź, czy Clavimo ma uprawnienie Dostępność i czy aplikacja jest nadal otwarta."
          }
        }
      }
    },
    "Clavimo moves Caps Lock to a spare key (F18) at the keyboard level while these rules run, and restores it when remapping stops.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clavimo legt die Feststelltaste auf Tastaturebene auf eine freie Taste (F18), solange diese Regeln laufen, und stellt sie wieder her, wenn die Neubelegung stoppt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy te reguły działają, Clavimo przenosi Caps Lock na wolny klawisz (F18) na poziomie klawiatury i przywraca go, gdy przemapowanie się zatrzyma."
          }
        }
      }
    },
    "Clavimo starts in the background when you sign in to this macOS account. It cannot change input at the login screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clavimo startet im Hintergrund, wenn du dich bei diesem macOS-Account anmeldest. Im Anmeldefenster kann es keine Eingaben ändern."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clavimo uruchamia się w tle po zalogowaniu na to konto macOS. Na ekranie logowania nie może zmieniać wejścia."
          }
        }
      }
    },
    "Clavimo: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
