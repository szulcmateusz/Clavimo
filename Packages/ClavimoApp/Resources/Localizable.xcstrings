    },
    "Existing": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Istniejące"
          }
        }
      }
    },
    "Experimental: the rule applies only when Clavimo can tell which device sent the input.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksperymentalne: reguła działa tylko wtedy, gdy Clavimo rozpozna, z którego urządzenia przyszło wejście."
          }
        }
      }
    },
    "Export...": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportuj…"
          }
        }
      }
    },
    "Exported files contain your rules, app identifiers and device IDs, never anything you typed. Importing shows the changes before anything is applied.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportowany plik zawiera Twoje reguły, identyfikatory aplikacji i urządzeń, nigdy wpisanego tekstu. Import najpierw pokazuje zmiany, a dopiero potem je stosuje."
          }
