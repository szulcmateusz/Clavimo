      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnięcie klawisza robi co innego: skrót, modyfikatory, warstwę, akcję albo nic."
          }
        }
      }
    },
    "Pressing the keys at the same moment does something else. Each key is held back for this long while you type, so keep it short.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnięcie klawiszy w tej samej chwili robi co innego. Podczas pisania każdy z tych klawiszy jest wstrzymywany na ten czas, więc ustaw go krótko."
          }
        }
      }
    },
