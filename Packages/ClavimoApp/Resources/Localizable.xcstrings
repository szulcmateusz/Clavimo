      }
    },
    "Any key, mouse button or trackpad gesture can open the compass. Keys and buttons work best: hold, move, let go.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Taste, Maustaste oder Trackpad-Geste kann den Kompass öffnen. Am besten funktionieren Tasten und Maustasten: halten, bewegen, loslassen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompas może otwierać dowolny klawisz, przycisk myszy albo gest gładzika. Najlepiej działają klawisze i przyciski: przytrzymaj, przesuń, puść."
