    "Fits your hardware": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt zu deiner Hardware"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasuje do Twojego sprzętu"
          }
        }
      }
    },
    "Five-finger tap: play or pause": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit fünf Fingern tippen: Wiedergabe/Pause"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknięcie pięcioma palcami: odtwórz lub wstrzymaj"
          }
        }
      }
    },
    "Fn": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fn"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fn"
          }
        }
      }
    },
    "Fn + four-finger swipe down: volume down": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fn + mit vier Fingern nach unten streichen: leiser"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fn + przesunięcie czterema palcami w dół: ciszej"
          }
        }
      }
    },
    "Fn + four-finger swipe up: volume up": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fn + mit vier Fingern nach oben streichen: lauter"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fn + przesunięcie czterema palcami w górę: głośniej"
          }
        }
      }
    },
    "Fn + left click: previous Space": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fn + Linksklick: vorheriger Space"
          }
        },
        "pl": {
