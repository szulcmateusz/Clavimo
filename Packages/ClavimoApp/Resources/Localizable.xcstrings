            "value": "Podczas czekania"
          }
        }
      }
    },
    "While you hold %@, %@ runs %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "While you hold %1$@, %2$@ runs %3$@."
