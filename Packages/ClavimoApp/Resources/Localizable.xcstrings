    "Open source under the MIT License. Clavimo processes input on your Mac only: it never records typed text and makes no network connections.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Source unter der MIT-Lizenz. Clavimo verarbeitet Eingaben nur auf deinem Mac: Es zeichnet nie eingegebenen Text auf und baut keine Netzwerkverbindungen auf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwarte oprogramowanie na licencji MIT. Clavimo przetwarza wejście wyłącznie na Twoim Macu: nigdy nie zapisuje wpisywanego tekstu i nie łączy się z siecią."
          }
        }
      }
    },
    "Open with": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen mit"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwieraj przez"
          }
        }
      }
    },
    "Opens %@": {
