    },
    "Swap two keys": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamień dwa klawisze"
          }
        }
      }
    },
    "Swapping both sides at once is not supported. Add one rule for each side.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamiana obu stron naraz nie jest obsługiwana. Dodaj osobną regułę dla każdej strony."
          }
        }
      }
    },
    "System": {
      "localizations": {
