    "For any mouse with back and forward buttons, Logitech mice included.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für jede Maus mit Zurück- und Vorwärts-Taste, auch von Logitech."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do każdej myszy z przyciskami Wstecz i Dalej, także Logitecha."
