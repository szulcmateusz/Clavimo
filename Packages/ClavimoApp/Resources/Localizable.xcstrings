        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabulatortaste halten: U I O, J K L und M , . schreiben 7 bis 1 wie ein Ziffernblock, N schreibt 0. Tabulatortaste antippen wie gewohnt."
          }
