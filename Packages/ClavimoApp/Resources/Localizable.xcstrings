            "value": "Zamiana Command i Option (prawe)"
          }
        }
      }
    },
    "Swap Command and Option, or turn any key into another.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamień Command z Option albo zmień dowolny klawisz w inny."
          }
        }
