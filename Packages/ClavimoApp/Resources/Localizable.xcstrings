    },
    "Clockwise is brighter, counterclockwise darker. Brightness keys may not work with external displays.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Uhrzeigersinn heller, dagegen dunkler. Helligkeitstasten funktionieren mit externen Displays eventuell nicht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W prawo jaśniej, w lewo ciemniej. Klawisze jasności mogą nie działać z zewnętrznymi monitorami."
          }
        }
      }
    },
    "Clockwise is louder, counterclockwise quieter, like a knob. Scrolling works as before.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Uhrzeigersinn lauter, dagegen leiser, wie ein Drehregler. Scrollen funktioniert wie bisher."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W prawo głośniej, w lewo ciszej, jak pokrętłem. Przewijanie działa jak dawniej."
          }
        }
      }
    },
