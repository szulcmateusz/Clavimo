    "Allow Clavimo to read and change input": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Clavimo, Eingaben zu lesen und zu ändern"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwól Clavimo odczytywać i zmieniać wejście"
          }
        }
      }
    },
    "Already on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits an."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Już włączone."
          }
        }
      }
    },
    "Also running: %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Außerdem läuft: %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa też: %@."
          }
        }
      }
    },
    "An app asked macOS to hide keystrokes (for example in a password field), so keyboard rules wait until it ends. Mouse and trackpad rules keep working.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine App hat macOS gebeten, Tastatureingaben zu verbergen (zum Beispiel in einem Passwortfeld), daher warten Tastaturregeln, bis das endet. Maus- und Trackpad-Regeln funktionieren weiter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakaś aplikacja poprosiła macOS o ukrycie naciśnięć klawiszy (na przykład w polu hasła), więc reguły klawiatury czekają, aż to się skończy. Reguły myszy i gładzika działają dalej."
          }
        }
      }
    },
