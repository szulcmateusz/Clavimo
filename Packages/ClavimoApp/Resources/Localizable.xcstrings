    "Priority decides between mouse chords with the same trigger. Key rules for the same key need different conditions; the most specific one wins.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Priorität entscheidet zwischen Maus-Kombinationen mit demselben Auslöser. Tastenregeln für dieselbe Taste brauchen unterschiedliche Bedingungen; die spezifischste gewinnt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Priorytet rozstrzyga między skrótami z myszą o tym samym wyzwalaczu. Reguły dla tego samego klawisza muszą mieć różne warunki; wygrywa najbardziej szczegółowa."
          }
        }
      }
    },
